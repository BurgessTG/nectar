# Nectar Configuration File
# Copy this file to nectar.toml and update local values.
version = "1.0"

[database]
driver = "mysql"
# MySQL-compatible DSN. Use MySQL 8 for the simpler target, or TiDB if needed.
# MySQL example:
# dsn = "user:password@tcp(localhost:3306)/nectar?charset=utf8mb4&parseTime=True&loc=Local"
# TiDB example:
# dsn = "root:@tcp(localhost:4000)/nectar?charset=utf8mb4&parseTime=True&loc=Local"
dsn = "user:password@tcp(localhost:3306)/nectar?charset=utf8mb4&parseTime=True&loc=Local"
connection_pool = 8
max_idle_conns = 4
max_open_conns = 8
conn_max_lifetime = 1800000000000

[cardano]
# Dolos 1.0 / Cardano node socket path. Do not use Demeter-specific paths here.
node_socket = "/path/to/dolos-or-cardano/node.socket"
# Network magic: 764824073 (mainnet), 1 (preprod), 2 (preview)
network_magic = 764824073
protocol_mode = "auto"

[indexing]
profile = "honeycomb"
transactions = true
blocks = true
metadata = true
assets = true
minting = true
utxos = false
inputs = true
outputs = true
certificates = false
governance = false
withdrawals = false
scripts = false
collateral = false
wallet_connections = true

[performance]
worker_count = 4
bulk_mode_enabled = true
bulk_fetch_range_size = 2000
stats_interval = 5000000000
blockfetch_timeout = 60000000000
block_queue_size = 2000

[dashboard]
enabled = true
type = "both"
web_port = 8080
detailed_log = false

[monitoring]
metrics_enabled = true
metrics_port = 9090
log_level = "info"
log_format = "json"

[metadata]
enabled = true
worker_count = 4
queue_size = 10000
rate_limit = 50
max_retries = 3
user_agent = "Nectar/1.0"

[state_query]
enabled = false
socket_path = ""
